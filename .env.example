# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# **DATABASE_URL**: PostgreSQL connection string used by Prisma.
# Default is a local DB on port 5432.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ------------------------------------------------------------
# API
# ------------------------------------------------------------

# **PORT**: HTTP port for the NestJS API server.
PORT=3000

# **FRONTEND_URL**: Allowed CORS origin for the frontend (cookies enabled).
FRONTEND_URL=http://localhost:4200

# **NODE_ENV**: Node runtime mode (development | production). Used as a fallback for observability env.
NODE_ENV=development

# **DEPLOYMENT_ENV**: Deployment environment label shown in observability tools (SigNoz).
# Use values like: development | staging | production.
DEPLOYMENT_ENV=development

# ------------------------------------------------------------
# AUTH / JWT
# ------------------------------------------------------------

# **JWT_SECRET**: Secret used to sign JWTs (CHANGE IN PRODUCTION).
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# **JWT_EXP**: Access token expiration (e.g. 5m, 1h, 7d).
JWT_EXP=5m

# ------------------------------------------------------------
# FRONTEND (Vite)
# ------------------------------------------------------------

# **VITE_API_URL**: Base URL used by the frontend to call the API.
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------
# OBSERVABILITY (SigNoz via OpenTelemetry)
# ------------------------------------------------------------

# **OTEL_ENABLED**: Master switch for all OpenTelemetry exporters (traces/logs). If false, nothing is sent over the network.
OTEL_ENABLED=true

# **OTEL_SERVICE_NAME**: Service name shown in SigNoz (e.g. "api", "worker").
OTEL_SERVICE_NAME=api

# **OTEL_EXPORTER_OTLP_TRACES_ENDPOINT**: OTLP/HTTP endpoint for traces.
# SigNoz default: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# **OTEL_EXPORTER_OTLP_LOGS_ENDPOINT**: OTLP/HTTP endpoint for logs.
# SigNoz default: http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# **OTEL_TRACE_SAMPLE_RATE**: Trace sampling ratio (0..1). Lower = less data.
# If unset, default is 1.0 in non-production and 0.1 in production.
OTEL_TRACE_SAMPLE_RATE=1

# **OTEL_LOGS_ENABLED**: Enable exporting request logs to SigNoz via OTLP logs.
# Default: disabled (enable when you explicitly want request logs in SigNoz).
OTEL_LOGS_ENABLED=false

# **OTEL_LOGS_MIN_STATUS**: Only export request logs with HTTP status >= this value.
# Example: 400 exports only 4xx/5xx.
OTEL_LOGS_MIN_STATUS=400

# **OTEL_LOGS_SAMPLE_RATE**: Sampling ratio (0..1) for exported request logs.
OTEL_LOGS_SAMPLE_RATE=1

# ------------------------------------------------------------
# LOGGING (stdout)
# ------------------------------------------------------------

# **LOG_LEVEL**: Global log level for stdout logs (pino). (trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# **LOG_HTTP_MIN_STATUS**: Only write request logs to stdout when status >= this value.
LOG_HTTP_MIN_STATUS=200

# **LOG_HTTP_SAMPLE_RATE**: Sampling ratio (0..1) for stdout request logs. 1 optimal for development, 0.1 optimal for production
LOG_HTTP_SAMPLE_RATE=1

# **LOG_REQUEST_START**: If true, also logs request "start" payloads (can be noisy).
LOG_REQUEST_START=false
